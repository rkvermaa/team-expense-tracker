{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "hex": "#111827"}, "$description": "Primary text"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882], "hex": "#4b5563"}, "$description": "Secondary text and hints"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page and surface background"},
  "color-bg-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9529, 0.9569, 0.9647], "hex": "#f3f4f6"}, "$description": "Subtle fills, hover, skeleton"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Brand and primary action"},
  "color-primary-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1176, 0.251, 0.6863], "hex": "#1e40af"}, "$description": "Primary hover/pressed"},
  "color-on-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Text on primary and danger fills"},
  "color-border": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8196, 0.8353, 0.8588], "hex": "#d1d5db"}, "$description": "Default borders and dividers"},
  "color-border-strong": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.4196, 0.4471, 0.502], "hex": "#6b7280"}, "$description": "Form control borders"},
  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Destructive and error"},
  "color-danger-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.6, 0.1059, 0.1059], "hex": "#991b1b"}, "$description": "Danger hover"},
  "color-danger-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.949, 0.949], "hex": "#fef2f2"}, "$description": "Danger tint"},
  "color-success": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0157, 0.4706, 0.3412], "hex": "#047857"}, "$description": "Success"},
  "color-success-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9255, 0.9922, 0.9608], "hex": "#ecfdf5"}, "$description": "Success tint"},
  "color-warning": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.5725, 0.251, 0.0549], "hex": "#92400e"}, "$description": "Warning"},
  "color-warning-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 0.9843, 0.9216], "hex": "#fffbeb"}, "$description": "Warning tint"},
  "color-info": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1176, 0.251, 0.6863], "hex": "#1e40af"}, "$description": "Info"},
  "color-info-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9373, 0.9647, 1], "hex": "#eff6ff"}, "$description": "Info tint"},
  "color-scrim": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000"}, "$description": "Backdrop scrim (see opacity-scrim)"},
  "color-tooltip-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "hex": "#111827"}, "$description": "Tooltip fill"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Tight spacing"},
  "space-2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Small spacing"},
  "space-3": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Medium spacing"},
  "space-4": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Large spacing"},
  "space-5": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Section spacing"},
  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Small radius"},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Medium radius"},
  "radius-lg": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}, "$description": "Large radius"},
  "radius-full": {"$type": "dimension", "$value": {"value": 999, "unit": "px"}, "$description": "Pill and circle"},
  "font-size-sm": {"$type": "dimension", "$value": {"value": 13, "unit": "px"}, "$description": "Small text"},
  "font-size-md": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Body text"},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Section headings"},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 28, "unit": "px"}, "$description": "Page titles"},
  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}, "$description": "Hairline border"},
  "border-width-strong": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}, "$description": "Focus ring"},
  "control-height-sm": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Small control height"},
  "control-height-md": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Default control height"},
  "control-height-lg": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Large control height"},
  "icon-size": {"$type": "dimension", "$value": {"value": 18, "unit": "px"}, "$description": "Checkbox/radio indicator"},
  "switch-width": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Switch track width"},
  "avatar-size": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Avatar diameter"},
  "drawer-width": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Drawer width"},
  "modal-width": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}, "$description": "Modal max width"},
  "menu-min-width": {"$type": "dimension", "$value": {"value": 180, "unit": "px"}, "$description": "Menu min width"},
  "toast-width": {"$type": "dimension", "$value": {"value": 320, "unit": "px"}, "$description": "Toast max width"},
  "shell-max-width": {"$type": "dimension", "$value": {"value": 1120, "unit": "px"}, "$description": "Page content max width"},
  "shell-nav-breakpoint": {"$type": "dimension", "$value": {"value": 720, "unit": "px"}, "$description": "Documented breakpoint where the nav expands (CSS media queries cannot read vars)"},

  "font-family-base": {"$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$description": "UI font; the app sets no custom font, so the system stack"},
  "font-weight-regular": {"$type": "fontWeight", "$value": 400},
  "font-weight-medium": {"$type": "fontWeight", "$value": 500},
  "font-weight-bold": {"$type": "fontWeight", "$value": 700},
  "line-height-base": {"$type": "number", "$value": 1.5},
  "opacity-scrim": {"$type": "number", "$value": 0.5},
  "opacity-disabled": {"$type": "number", "$value": 0.5},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-primary-border": {"$type": "color", "$value": "{color-primary}"},
  "button-primary-hover-background": {"$type": "color", "$value": "{color-primary-hover}"},
  "button-primary-radius": {"$type": "dimension", "$value": "{radius-md}"},
  "button-primary-padding": {"$type": "dimension", "$value": "{space-3}"},
  "button-secondary-background": {"$type": "color", "$value": "{color-bg}"},
  "button-secondary-foreground": {"$type": "color", "$value": "{color-fg}"},
  "button-secondary-border": {"$type": "color", "$value": "{color-border-strong}"},
  "button-secondary-hover-background": {"$type": "color", "$value": "{color-bg-subtle}"},
  "button-ghost-background": {"$type": "color", "$value": "{color-bg}"},
  "button-ghost-foreground": {"$type": "color", "$value": "{color-primary}"},
  "button-ghost-border": {"$type": "color", "$value": "{color-bg}"},
  "button-ghost-hover-background": {"$type": "color", "$value": "{color-bg-subtle}"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}"},
  "button-danger-foreground": {"$type": "color", "$value": "{color-on-primary}"},
  "button-danger-border": {"$type": "color", "$value": "{color-danger}"},
  "button-danger-hover-background": {"$type": "color", "$value": "{color-danger-hover}"},
  "card-default-background": {"$type": "color", "$value": "{color-bg}"},
  "card-default-foreground": {"$type": "color", "$value": "{color-fg}"},
  "card-default-border": {"$type": "color", "$value": "{color-border}"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-4}"},
  "input-default-background": {"$type": "color", "$value": "{color-bg}"},
  "input-default-border": {"$type": "color", "$value": "{color-border-strong}"},
  "input-invalid-border": {"$type": "color", "$value": "{color-danger}"}
}
