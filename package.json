{
  "name": "team-expense-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "next dev -p ${ARC_WEB_PORT:-3004}",
    "build": "next build",
    "start": "next start -p ${ARC_WEB_PORT:-3004}",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run && npm run test --workspaces",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "jose": "^5.9.6",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
